[
  { "id": "t01", "text": "Et sinon, tu fais quoi dans la vie ?" },
  { "id": "t02", "text": "On ne se refait pas." },
  { "id": "t03", "text": "Comme on dit." },
  { "id": "t04", "text": "Franchement." },
  { "id": "t05", "text": "Du coup." },
  { "id": "t06", "text": "C'est clair." },
  { "id": "t07", "text": "Voilà quoi." },
  { "id": "t08", "text": "Sans vouloir vexer personne." },
  { "id": "t09", "text": "C'est comme qui dirait." },
  { "id": "t10", "text": "Bref." },
  { "id": "t11", "text": "Ça va, ça va." },
  { "id": "t12", "text": "Pour être honnête." },
  { "id": "t13", "text": "Je dis ça, je dis rien." },
  { "id": "t14", "text": "Enfin tu vois ce que je veux dire." },
  { "id": "t15", "text": "C'est fou quand même." },
  { "id": "t16", "text": "On n'est plus à ça près." },
  { "id": "t17", "text": "Comme quoi." },
  { "id": "t18", "text": "Il faut ce qu'il faut." },
  { "id": "t19", "text": "C'est le principal." },
  { "id": "t20", "text": "Ça reste entre nous." },
  { "id": "t21", "text": "On refait le monde." },
  { "id": "t22", "text": "C'est pas faux." },
  { "id": "t23", "text": "Au final." },
  { "id": "t24", "text": "N'empêche." },
  { "id": "t25", "text": "C'est dingue non ?" }
]
